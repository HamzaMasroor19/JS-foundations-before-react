//CALLBACK TASK RUNNER PROJECT 
function runtask(name, status, callback) {
    console.log(`TaskName: ${name}`);
    console.log(`Status: ${status}`);
    callback(name);
}

function reading(task) {
    console.log("Reading the Quran => " + task);
}

function learning(task) {
    console.log("Learning JS => " + task);
}

function workout(task) {
    console.log("Working OUT => " + task);
}

runtask("Javascript", "Completed", learning);
runtask("Reading", "Completed", reading);
runtask("Squat", "Completed", workout);
